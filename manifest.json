{
  "manifest_version": 3,
  "name": "Gemini & NotebookLM Bildirim Gönderici",
  "version": "1.0.0",
  "description": "Gemini ve NotebookLM'de cevaplar geldiğinde bildirim gönderir",
  "permissions": [
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
